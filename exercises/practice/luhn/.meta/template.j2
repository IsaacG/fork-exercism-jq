{{ header }}
{% for case in cases %}
@test "{{ case["description"] }}" {
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip

    run jq -r -f {{ solution }} <<< '"{{ case["input"]["value"] }}"'

    assert_success
    expected={{ case["expected"] | lower }}
    assert_equal "$output" "$expected"
}
{% endfor %}
