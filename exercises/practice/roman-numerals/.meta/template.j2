{{ header }}
{% for case in cases %}
@test '{{ case["description"] }}' {
    {% if loop.first %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip
    run jq -r -f {{ solution }} <<< {{ case["input"] | tojson(separators=(", ", ": ")) | quote }}
    assert_success
    expected='{{ case["expected"] }}'
    assert_equal "$output" "$expected"
}
{% endfor %}
